# ──────────────────────────────────────────────
#  kiada-go — Environment Variable Reference
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# Port the Go HTTP server listens on (default: 8080)
LISTEN_PORT=8080

# Kubernetes Downward API — injected automatically by the Deployment manifest
POD_NAME=local-dev
POD_IP=127.0.0.1
NODE_NAME=local-node
NODE_IP=127.0.0.1

# URLs of upstream services (Chapter 11 — Services)
QUOTE_URL=http://quote.kiada.svc.cluster.local/quote
QUIZ_URL=http://quiz.kiada.svc.cluster.local

# Optional status message shown in the root response
INITIAL_STATUS_MESSAGE=Running locally

# Container registry (used by Makefile docker-build / docker-push)
REGISTRY=docker.io/yourusername
